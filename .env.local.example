# Supabase (프로젝트 Settings > API 에서 복사)
# 이 두 값이 없으면 앱은 lib/characters.ts 의 정적 더미데이터로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# LLM (서버 전용 — NEXT_PUBLIC_ 을 붙이면 브라우저에 노출되니 절대 금지)
GEMINI_API_KEY=AQ.xxxxxxxx
# 앞에서부터 순서대로 시도. 무료 티어는 모델별로 혼잡도가 달라 여러 개를 둔다.
# LLM_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.7-flash

# Supabase 비밀 키 (서버 전용 — 대화 기록 읽기/쓰기용)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
